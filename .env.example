# Copy to .env and fill in. .env is gitignored.

# GitHub personal access token with `repo` scope — used by scripts/release.ts to
# publish GitHub Releases and upload binary assets.
GITHUB_TOKEN=

# owner/repo, e.g. jsuchy/pipm. Auto-set in GitHub Actions as GITHUB_REPOSITORY;
# set it only for local `--publish` runs.
GITHUB_REPOSITORY=
