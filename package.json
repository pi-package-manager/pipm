{
	"name": "pipm",
	"version": "0.0.1",
	"description": "pipm - Pi Package Manager. An immutable, OCX-style registry for Pi skills, extensions, plugins and profiles.",
	"author": "jsuchy@haproxy.com",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"bin": {
		"pipm": "./dist/index.js"
	},
	"files": [
		"dist/index.js"
	],
	"engines": {
		"bun": ">=1.2.0"
	},
	"scripts": {
		"build": "bun run scripts/build.ts",
		"build:binary": "bun run scripts/build-binary.ts",
		"docs:build": "bun run scripts/build-docs.ts",
		"build:binary:all": "bun run scripts/build-binary.ts --all",
		"check": "bun check:biome && bun check:types",
		"check:biome": "biome check .",
		"check:types": "tsc --noEmit",
		"dev": "bun run src/index.ts",
		"test": "bun test",
		"test:binary": "PIPM_DIST_TESTS=1 bun test tests/binary-smoke.test.ts",
		"release": "bun run scripts/release.ts"
	},
	"dependencies": {
		"commander": "^14.0.3",
		"jsonc-parser": "3.3.1",
		"kleur": "^4.1.5",
		"semver": "^7.7.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@types/bun": "^1.3.11",
		"@types/semver": "^7.7.0",
		"marked": "^18.0.9",
		"typescript": "^5.7.3"
	}
}
